# ─────────────────────────────────────────────────────────────────────────────
# GerminaVision + Evolution API v2 - Variaveis de ambiente
# Copie para .env e preencha os valores reais.
# NUNCA commite o .env com valores reais.
# ─────────────────────────────────────────────────────────────────────────────

# Nota: EVOLUTION_API_URL, EVOLUTION_API_HOST_HEADER e EVOLUTION_SSL_VERIFY
# nao aparecem aqui porque o docker-compose.yml ja os define internamente
# (Evolution API alcançada por nome de servico na rede Docker, sem SSL).
# Se rodar fora do Docker, adicione-os manualmente.

# ── Evolution API - Autenticacao ──────────────────────────────────────────────
# Chave de acesso a Evolution API. Escolha uma string longa e aleatoria.
# Esta mesma chave vai em AUTHENTICATION_API_KEY (Evolution) e EVOLUTION_API_KEY (GerminaVision).
EVOLUTION_API_KEY=troque-por-uma-chave-segura-e-longa

# Nome da instancia WhatsApp (pode manter "germinavision")
EVOLUTION_INSTANCE_NAME=germinavision

# ── GerminaVision - URL publica ───────────────────────────────────────────────
# URL onde a GerminaVision esta acessivel pela Evolution API para disparar o webhook.
# Opcoes:
#   - Deixe VAZIO para usar a rede interna Docker (http://germinavision:5001).
#     Funciona quando Evolution API e GerminaVision estao na mesma stack Docker.
#   - IP da LAN, ex: http://192.168.1.100:5001  (so se Evolution estiver fora do Docker)
#   - Tunnel Cloudflare, ex: https://germinavision.dehor.com.br
PUBLIC_BASE_URL=

# ── OpenRouter (chatbot da GerminaVision) ─────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-sua-chave-openrouter-aqui

# ── PostgreSQL (banco da Evolution API) ───────────────────────────────────────
POSTGRES_DB=evolution
POSTGRES_USER=evolution
# IMPORTANTE: use apenas letras e numeros (sem @, :, /, ?, #, & ou espacos).
# Esses caracteres especiais quebram a DATABASE_CONNECTION_URI sem encoding.
POSTGRES_PASSWORD=troque-por-senha-segura

# ── GerminaVision - Comportamento de grupos ───────────────────────────────────
# Opcoes: off | mention_only | image_always_text_mention | all
GROUP_RESPONSE_MODE=image_always_text_mention

# Numero do bot sem + nem espacos (para detectar @mention em grupos)
EVOLUTION_INSTANCE_PHONE=556298561249

# Grupos permitidos: lista de JIDs separados por virgula (vazio = todos os grupos)
# Exemplo: 5511999999999@g.us,5521888888888@g.us
ALLOWED_GROUPS=

# Capacidade padrao da bandeja de sementes
TRAY_CAPACITY=200

# ── GerminaVision - Guards de imagem ─────────────────────────────────────────
GUARD_MIN_DETECTIONS=3
GUARD_MIN_MEAN_CONF=0.55
