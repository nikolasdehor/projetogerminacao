OPENROUTER_API_KEY=your_openrouter_api_key_here

# URL pública onde o GerminaVision está acessível (cloudflared tunnel, domínio próprio, etc).
# Usada para montar o webhook do WhatsApp.
PUBLIC_BASE_URL=https://seu-tunnel.trycloudflare.com

# Evolution API (WhatsApp)
EVOLUTION_API_URL=https://sua-instancia.evolution-api.com
EVOLUTION_API_KEY=sua_chave_aqui
EVOLUTION_INSTANCE_NAME=germinavision
# Opcional: conecte por IP e envie o host original quando a rede bloquear DNS dinâmico.
EVOLUTION_API_HOST_HEADER=
# Use false apenas em ambiente local quando a Evolution estiver atrás de proxy/CA privada.
EVOLUTION_SSL_VERIFY=true

# Tratamento de grupos
# Opcoes: off, mention_only, image_always_text_mention (default), all
GROUP_RESPONSE_MODE=image_always_text_mention

# Numero do bot (pra detectar @mention em grupos), sem + nem espacos
EVOLUTION_INSTANCE_PHONE=556298561249

# Grupos permitidos (CSV de JIDs completos com @g.us), vazio = todos
ALLOWED_GROUPS=

# Capacidade da bandeja (default 200)
TRAY_CAPACITY=200
